  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary-dark",
      "description": "Primary action pattern extracted from the implemented workbench.",
      "html": "<button class=\"ds-primary\">Launch CLI</button>",
      "css": ".ds-primary{font-family:var(--font-sans,Arial,sans-serif);font-size:13px;color:var(--text-primary,#ededed);display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:40px;padding:9px 14px;border:1px solid var(--border-default,#3c3c3c);border-radius:4px;font-weight:500;background:transparent;cursor:pointer;transition:background-color .15s;background:var(--accent-primary,#e2e2e2);border-color:var(--accent-primary,#e2e2e2);color:var(--primary-ink,#1b1b1b)}.ds-primary:hover{background:var(--accent-hover,#fff)}.ds-primary:focus-visible{outline:2px solid var(--text-primary,#ededed);outline-offset:3px}.ds-primary:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Outlined action",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Outlined action pattern extracted from the implemented workbench.",
      "html": "<button class=\"ds-outline\">Refresh tools</button>",
      "css": ".ds-outline{font-family:var(--font-sans,Arial,sans-serif);font-size:13px;color:var(--text-primary,#ededed);display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:40px;padding:9px 14px;border:1px solid var(--border-default,#3c3c3c);border-radius:4px;font-weight:500;background:transparent;cursor:pointer;transition:background-color .15s;}.ds-outline:hover{background:var(--bg-hover,#353535)}.ds-outline:focus-visible{outline:2px solid var(--text-primary,#ededed);outline-offset:3px}.ds-outline:disabled{opacity:.45;cursor:not-allowed}"
    },

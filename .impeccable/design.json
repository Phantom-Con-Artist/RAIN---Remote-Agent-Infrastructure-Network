  "narrative": {
    "northStar": "RAIN workbench",
    "overview": "RAIN is a neutral Material-like developer workbench for launching and coordinating CLI agents. Paper and graphite surfaces, familiar system typography, and restrained rectangular controls keep machine context and task actions legible. The existing React/Tauri implementation uses plain CSS; this document captures that system rather than prescribing a component-framework migration.\n\nDesktop is the primary workspace; smaller screens remain remote controls. The ASCII RAIN wordmark and matching monogram belong in application chrome. Ordinary task labels stay readable sans serif. The North Star names the existing workbench direction; it is not a separately approved brand concept.",
    "keyCharacteristics": [
      "Neutral light and dark themes.",
      "Visible machine scope for execution and filesystem tasks.",
      "Flat task regions and compact rectangular controls.",
      "ASCII identity; system sans for tasks and mono for technical content."
    ],
    "rules": [
      {
        "name": "Scope Continuity",
        "body": "Keep the selected machine visible in launch and file tasks. Changing it clears the explorer and editor; do not imply a local write when the selected filesystem is remote.",
        "section": "layout"
      },
      {
        "name": "Neutral Actions",
        "body": "Use monochrome emphasis for primary actions; reserve semantic color for meaningful status, warning, and destructive states.",
        "section": "colors"
      },
      {
        "name": "Flat Workbench",
        "body": "Use tonal surfaces and dividers for ordinary task structure; reserve pronounced shadows for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve both theme mappings when adding a surface.",
      "Do keep selected machine and path context legible before launch, edit, save, or terminal actions.",
      "Do use system sans for task labels and mono for paths, terminal content, and ASCII identity.",
      "Do retain visible keyboard focus and explicit placeholder contrast in both themes.",
      "Do keep groups as conversation-routing and workflow records; agent sessions have independent lifecycles."
    ],
    "donts": [
      "Don't introduce gradients, blue hues, or pill controls.",
      "Don't turn ordinary controls and labels into ASCII art.",
      "Don't wrap every task section in a raised card.",
      "Don't hide machine context to gain space.",
      "Don't treat screenshot review as physical-device, SSH, or comprehensive accessibility certification."
    ]
  }
}

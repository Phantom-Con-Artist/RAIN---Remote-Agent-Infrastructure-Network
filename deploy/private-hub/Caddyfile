{
	admin off
	auto_https disable_redirects
	skip_install_trust
	persist_config off
	log default {
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Rain-Worker-Token delete
				request>headers>X-Rain-Agent-Token delete
				request>headers>X-Rain-Owner-Key delete
				request>headers>X-Rain-Gateway-Token delete
				request>headers>X-Rain-Task-Lease delete
				request>headers>X-Rain-Device-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

# Run Caddy on the HUB, outside containers so loopback reaches rain-daemon.
# WireGuard must already route the private address. Firewall WAN TCP 443 closed.
# Owner supplies the private address, certificate trust and gateway secret.
https://{$RAIN_PRIVATE_HOST} {
	bind {$RAIN_VPN_ADDRESS}
	tls internal
	# RAIN authenticates the sysadmin key and scoped worker/agent credentials.
	reverse_proxy 127.0.0.1:7890 {
		header_up X-Rain-Gateway-Token {$RAIN_GATEWAY_TOKEN}
	}
}

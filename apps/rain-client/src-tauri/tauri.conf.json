{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAIN Client",
  "version": "0.1.0",
  "identifier": "network.rain.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RAIN — Remote Agent Infrastructure Network",
        "width": 1120,
        "height": 780,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
